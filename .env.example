# Скопируй в .env и заполни. Всё, что читает приложение, объявлено
# в pkg/config/config.go — здесь нет ни одной переменной, которой нет там.
#
# Проверки при старте живут в config.Validate(): процесс не поднимется,
# пока обязательный блок не заполнен, и скажет разом обо всех проблемах.

# ============================================================
# ОБЯЗАТЕЛЬНО — без этого процесс не стартует
# ============================================================

# База. Пустых значений нет и дефолтов нет: пустой хост = отказ на первом пинге
# (таймаут 5 секунд, см. repository.pingTimeout).
REPO_DB_HOST=localhost
REPO_DB_PORT=5435
REPO_DB_USERNAME=postgres
REPO_DB_PASSWORD=
REPO_DB_NAME=blackwatch_db
REPO_DB_SSLMODE=disable

DISCORD_TOKEN=
# Сервер, куда регистрируются слэш-команды. Без него команды уехали бы
# в чужую гильдию по захардкоженному ID — поэтому проверяется.
GUILD_ID=
# Разбор скриншотов матчей. Без него бот не умеет своей основной работы.
GEMINI_KEY=

# Кто может администрировать. Нужна хотя бы одна из двух: права резолвятся
# только через них, и с обоими пустыми бот стартует, зарегистрирует команды —
# и ответит «У вас нет прав» вообще всем.
#   ADMIN_USER_IDS  — Discord user ID через запятую, полный доступ
#   REFEREE_ROLE_ID — роль SUDЬЯ: жизненный цикл матча (create/balance/cancel/WIN)
ADMIN_USER_IDS=
REFEREE_ROLE_ID=

# ============================================================
# ОПЦИОНАЛЬНО — без этого бот работает, но соответствующая функция выключена
# ============================================================

# --- Telegram: ставки на матчи ---
# Без TELEGRAM_TOKEN бот телеграма не поднимается совсем.
# TELEGRAM_CHANNEL_ID без TELEGRAM_TOKEN — ошибка старта, а не тихий скип.
TELEGRAM_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_IDS=

# Номиналы кнопок ставки под постом матча и потолок одной ставки.
# BET_AMOUNTS сортируется и дедуплицируется на старте; номинал больше BET_MAX —
# ошибка старта, а не тихое обрезание: кнопка, которую база откажется принять,
# выглядит как сломанный бот.
# BET_MAX ограничивает и кнопку «Макс», и любую сумму из callback: данные кнопки
# приходят от клиента, а не от нас.
BET_AMOUNTS=10,25,50
BET_MAX=100

# --- Ранговые роли по MMR ---
# Пустая роль = этот ранг не выдаётся. Все пустые = синк ролей выключен.
TIER_ROLE_OBSIDIAN=
TIER_ROLE_ONYX=
TIER_ROLE_CARBON=
TIER_ROLE_GRAPHITE=
# Куда постить повышения/понижения. Пусто = канал, где закрыли матч.
TIER_ANNOUNCE_CHANNEL_ID=

# --- FAQ-ассистент ---
# Нужны оба: канал и ключ. Без ключа ассистент выключен.
FAQ_CHANNEL_ID=
DEEPSEEK_KEY=
FAQ_FILE_PATH=assets/faq.md

# --- Google Sheets ---
# Нужны оба: файл ключа на диске и ID таблицы. Файла нет или ID пустой —
# интеграция выключается с предупреждением в лог.
GOOGLE_CREDENTIALS_PATH=google-credentials.json
GOOGLE_SHEET_ID=
GOOGLE_OWNER_EMAIL=

# --- Клан-тег ---
# CLAN_TAG_ENABLED=true при пустом CLAN_TAG_ROLE_ID — ошибка старта.
CLAN_TAG_ENABLED=false
CLAN_TAG_ROLE_ID=

# --- Веб-дашборд ---
# Дефолтного ключа нет намеренно: раньше он был литералом "blackwatch-admin",
# то есть каждый деплой поднимал панель с общеизвестным паролем.
# Пусто = панель не стартует вообще.
WEB_ADMIN_KEY=
WEB_ADMIN_PORT=8080
# CIDR или голые IP обратных прокси, которым можно верить X-Forwarded-For
# и X-Forwarded-Proto. Пусто = не верить никому и брать адрес соединения.
# Не заполняй, если панель не за прокси: иначе кто угодно подберёт себе
# адрес одним заголовком и обойдёт лимит на попытки входа.
WEB_ADMIN_TRUSTED_PROXIES=

# --- Прочее ---
# Канал, где принимаются скриншоты. Пусто = принимать во всех.
ALLOWED_CHANNEL_ID=
# debug | info | warn | error
LOGGER_LEVEL=info
HTTP_TIMEOUT_SEC=10
PLAYER_CACHE_SIZE=100000
